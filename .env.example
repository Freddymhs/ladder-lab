# Transport: "stdio" (default) or "http"
MCP_TRANSPORT=stdio

# HTTP transport settings (only used when MCP_TRANSPORT=http)
PORT=3000
# Interfaz donde escucha. Loopback por defecto. En el Mac Mini se publica el
# puerto solo en la IP de Tailscale (docker run -p <ip-tailscale>:3000:3000);
# dentro del contenedor la imagen ya fija MCP_HOST=0.0.0.0.
MCP_HOST=127.0.0.1
# Obligatorio con MCP_TRANSPORT=http. Mínimo 32 caracteres. Generar con:
#   openssl rand -hex 32
# El valor real vive solo en el host y en la config local de Claude Code.
MCP_AUTH_TOKEN=

# Supabase (obligatorio fuera de NODE_ENV=test). Proyecto propio de ladder-lab.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Respaldo (pnpm respaldo): carpeta de destino y cuántos respaldos se conservan.
# La carpeta debe estar FUERA del Mac Mini y de Supabase en el sentido de que se
# copia a otro lado (docs/decisions/DECISION_RESPALDO.md).
RESPALDO_DIR=respaldos
RESPALDO_RETENCION=30

# Logging
LOG_LEVEL=info

# Server
NODE_ENV=development
